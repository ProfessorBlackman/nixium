#!/usr/bin/env bash
# Fast checks only — anything slow gets bypassed with --no-verify and then stops being a gate.
# The full suite is `make check`, and CI runs it on every push.
set -euo pipefail

staged() { git diff --cached --name-only --diff-filter=ACM; }

if staged | grep -q '\.rs$'; then
    echo "pre-commit: cargo fmt --check"
    if ! (cd src-tauri && cargo fmt --all --check); then
        echo
        echo "Rust sources are unformatted. Run 'make fmt' and stage the result." >&2
        exit 1
    fi
fi

# 3.6 GB of build artefacts live under src-tauri/target; catch it if .gitignore ever regresses.
if staged | grep -qE '(^|/)target/'; then
    echo "pre-commit: refusing to commit build artefacts under target/" >&2
    exit 1
fi

# Every source file carries its licence. Generated bindings are excluded: ts-rs rewrites them on
# each build, so a header there would be lost — they are covered by the repository LICENSE.
missing=$(staged | grep -E '\.(rs|ts|tsx|css)$' | grep -v '^src/bindings/' | while read -r f; do
    [ -f "$f" ] || continue
    head -c 400 "$f" | grep -q 'SPDX-License-Identifier: GPL-3.0-or-later' || echo "  $f"
done)
if [ -n "$missing" ]; then
    echo "pre-commit: these files are missing their SPDX licence header:" >&2
    echo "$missing" >&2
    echo >&2
    echo "Add at the top:" >&2
    echo "  // SPDX-License-Identifier: GPL-3.0-or-later" >&2
    echo "  // Copyright (C) 2026 Methuselah Nwodobeh" >&2
    exit 1
fi
