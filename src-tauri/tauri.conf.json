{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nix",
  "version": "0.2.0",
  "identifier": "com.tlc.nix",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nix",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Find out where your disk went and reclaim it safely",
    "longDescription": "nix tells you where your disk went, reclaims it safely, and shows you what your machine is doing while it does.",
    "linux": {
      "deb": {
        "depends": [
          "policykit-1 | polkit"
        ],
        "files": {
          "/usr/libexec/nix/nix-helper": "target/release/nix-helper",
          "/usr/share/polkit-1/actions/com.tlc.nix.policy": "../packaging/polkit/com.tlc.nix.policy",
          "/usr/share/applications/com.tlc.nix.desktop": "../packaging/nix.desktop",
          "/usr/share/doc/nix/copyright": "../LICENSE",
          "/usr/share/doc/nix/THIRD-PARTY-NOTICES.md": "../THIRD-PARTY-NOTICES.md"
        }
      },
      "rpm": {
        "depends": [
          "polkit"
        ],
        "files": {
          "/usr/libexec/nix/nix-helper": "target/release/nix-helper",
          "/usr/share/polkit-1/actions/com.tlc.nix.policy": "../packaging/polkit/com.tlc.nix.policy",
          "/usr/share/applications/com.tlc.nix.desktop": "../packaging/nix.desktop",
          "/usr/share/licenses/nix/LICENSE": "../LICENSE",
          "/usr/share/doc/nix/THIRD-PARTY-NOTICES.md": "../THIRD-PARTY-NOTICES.md"
        }
      }
    }
  }
}
